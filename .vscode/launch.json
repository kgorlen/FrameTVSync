{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Python Debugger: Current File",
            "type": "debugpy",
            "request": "launch",
            "program": "${file}",
            "console": "integratedTerminal"
        },
        {
            "name": "samsungtv with Arguments",
            "type": "node-terminal",
            "request": "launch",
            "command": "${workspaceFolder}/.venv/Scripts/samsungtv.exe --host 192.168.1.143 --token-file ${workspaceFolder}/.frametvsync.token --name frametvsync ${input:samsungtvArgs}"
        },
        {
            "name": "Python Debugger: frametvsync",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/src/frametvsync/frametvsync.py",
            "console": "integratedTerminal",
            "args": [
                "\\\\NAS0\\Multimedia\\Pictures\\Art Frame\\Favorites"
            ]
        },
        {
            "name": "Python Debugger: frametvsync --dry-run",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/src/frametvsync/frametvsync.py",
            "console": "integratedTerminal",
            "args": [
                "--dry-run",
                "\\\\NAS0\\Multimedia\\Pictures\\Art Frame\\Favorites"
            ]
        },
        {
            "name": "Python Debugger: frametvsync --watch --no-quiet",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/src/frametvsync/frametvsync.py",
            "console": "integratedTerminal",
            "args": [
                "--watch",
                "--no-quiet",
                "\\\\NAS0\\Multimedia\\Pictures\\Art Frame\\Favorites"
            ]
        },
        {
            "name": "Python Debugger: frametvsync --ip '192.168.1.143' (WiFi)",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/src/frametvsync/frametvsync.py",
            "console": "integratedTerminal",
            "args": [
                "--ip",
                "192.168.1.143"
            ]
        },
        {
            "name": "Python Debugger: frametvsync --ip '192.168.1.122' (Wire)",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/src/frametvsync/frametvsync.py",
            "console": "integratedTerminal",
            "args": [
                "--ip",
                "192.168.1.122"
            ]
        },
        {
            "name": "Python Debugger: frametvsync --dry-run --reset",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/src/frametvsync/frametvsync.py",
            "console": "integratedTerminal",
            "args": [
                "--dry-run",
                "--reset",
                "\\\\NAS0\\Multimedia\\Pictures\\Art Frame\\Favorites"
            ]
        },
        {
            "name": "Python Debugger: frametvsync --help",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/src/frametvsync/frametvsync.py",
            "console": "integratedTerminal",
            "args": [
                "-h"
            ]
        },
        {
            "name": "Python Debugger: frametvsync --version",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/src/frametvsync/frametvsync.py",
            "console": "integratedTerminal",
            "args": [
                "--version"
            ]
        }
    ],
    "inputs": [
        {
            "id": "samsungtvArgs",
            "type": "promptString",
            "description": "Arguments for samsungtv",
            "default": "--help"
        }
    ]
}